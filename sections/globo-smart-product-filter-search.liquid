    };
    var GSF_START_PRODUCTS = 500;          // the slider starts here (same as the original page)
    // Slider labels: one label per price tier, evenly spaced (every slider step has the same width).
    // Desktop shows all, tablet shows every 2nd label, mobile shows first / middle / last.

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function fmt(n) { return Number(n).toLocaleString('en-US'); }
    function short(n) {
      if (n >= 1000000) return (Math.round(n / 100000) / 10) + 'M';
      if (n >= 1000) return (Math.round(n / 100) / 10) + 'K';
      return String(n);
    }

    /* ---------- Expand / collapse with height animation (feature groups) ---------- */
    function setOpen(btn, panel, open, animate) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (!animate || reduceMotion) {
        panel.hidden = !open;
        panel.style.height = '';
        return;
      }
      if (open) {
        panel.hidden = false;
        var h = panel.scrollHeight;
        panel.style.height = '0px';
        panel.offsetHeight; // reflow
        panel.style.height = h + 'px';
        panel.addEventListener('transitionend', function done(e) {
          if (e.target !== panel) return;
          panel.removeEventListener('transitionend', done);
          if (btn.getAttribute('aria-expanded') === 'true') panel.style.height = '';
        });
      } else {
        panel.style.height = panel.scrollHeight + 'px';
        panel.offsetHeight;
        panel.style.height = '0px';
        panel.addEventListener('transitionend', function done(e) {
          if (e.target !== panel) return;
          panel.removeEventListener('transitionend', done);
          if (btn.getAttribute('aria-expanded') === 'false') { panel.hidden = true; panel.style.height = ''; }
        });
      }
    }

    /* ---------- Pricing: platform switch + product slider ---------- */
    function initPricing(root) {
      var box = root.querySelector('[data-gsf-pricing]');
      if (!box) return;
      var range = box.querySelector('[data-gsf-range]');
      var countEl = box.querySelector('[data-gsf-count]');
      var priceEls = box.querySelectorAll('[data-gsf-price]');
      var platformBtns = box.querySelectorAll('[data-gsf-platform]');
      var labelsWrap = box.querySelector('[data-gsf-range-labels]');
      var platform = 'shopify';
      var products = GSF_PRICING.shopify.map(function (p) { return p.products; });
      var max = products.length - 1;
      range.max = max;
      var start = products.indexOf(GSF_START_PRODUCTS);
      range.value = start < 0 ? 0 : start;

      var mid = Math.round(max / 4) * 2;   // middle label on an even step, so it is also kept on tablet
      var labelBtns = products.map(function (count, idx) {
        var edge = idx === 0 || idx === max;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'gsf-range-label' +
          (!edge && idx % 2 === 1 ? ' gsf-range-label--d' : '') +            // hidden on tablet (≤1024px)
          (!edge && idx !== mid ? ' gsf-range-label--t' : '') +              // hidden on mobile (≤767px)
          (idx === 0 ? ' gsf-range-label--first' : '') + (idx === max ? ' gsf-range-label--last' : '');
        b.style.setProperty('--p', idx / max);
        b.textContent = short(count);
        b.setAttribute('aria-label', 'Set to ' + fmt(count) + ' products');
        b.tabIndex = -1;
        b.dataset.idx = idx;
        b.addEventListener('click', function () { range.value = idx; update(); });
        labelsWrap.appendChild(b);
        return b;
      });

      function update() {
        var plans = GSF_PRICING[platform];
        var idx = Math.max(0, Math.min(parseInt(range.value, 10) || 0, plans.length - 1));
        var plan = plans[idx];
        countEl.textContent = fmt(plan.products);
        range.setAttribute('aria-valuetext', fmt(plan.products) + ' products');
        range.style.setProperty('--gsf-fill', (idx / (plans.length - 1) * 100) + '%');
        priceEls.forEach(function (el) {
          var key = el.getAttribute('data-gsf-price');
          if (plan[key] !== undefined) el.textContent = fmt(plan[key]);
        });
        labelBtns.forEach(function (b) { b.classList.toggle('is-active', +b.dataset.idx === idx); });
      }
      range.addEventListener('input', update);
      range.addEventListener('change', update);
      platformBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          platform = btn.getAttribute('data-gsf-platform');
          platformBtns.forEach(function (b) { b.setAttribute('aria-selected', b === btn ? 'true' : 'false'); });
          update();
        });
      });

      // "Show all 10 features" (mobile)
      box.querySelectorAll('[data-gsf-more]').forEach(function (btn) {
        var card = btn.closest('.gsf-plan');
        var label = btn.querySelector('[data-gsf-more-label]');
        btn.addEventListener('click', function () {
          var open = !card.classList.contains('is-expanded');
          card.classList.toggle('is-expanded', open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          label.textContent = open ? 'Show fewer features' : 'Show all 10 features';
        });
      });
      update();
    }

    /* ---------- Feature table groups ---------- */
    function initCompare(root) {
      var groups = Array.prototype.slice.call(root.querySelectorAll('[data-gsf-group]')).map(function (g) {
        return { btn: g.querySelector('[data-gsf-group-toggle]'), panel: g.querySelector('[data-gsf-group-panel]') };
      });
      var all = root.querySelector('[data-gsf-expand-all]');
      function syncAll() {
        var allOpen = groups.every(function (g) { return g.btn.getAttribute('aria-expanded') === 'true'; });
        all.textContent = allOpen ? 'Collapse all' : 'Expand all';
        all.setAttribute('aria-expanded', allOpen ? 'true' : 'false');
      }
      groups.forEach(function (g) {
        g.btn.addEventListener('click', function () {
          setOpen(g.btn, g.panel, g.btn.getAttribute('aria-expanded') !== 'true', true);
          syncAll();
        });
      });
      if (all) {
        all.addEventListener('click', function () {
          var open = all.getAttribute('aria-expanded') !== 'true';
          groups.forEach(function (g) { setOpen(g.btn, g.panel, open, false); });
          syncAll();
        });
        syncAll();
      }
    }

    /* ---------- Sticky Basic / Professional header of the feature table ----------
       1) position:sticky breaks when an ancestor has overflow:hidden – swap it for overflow:clip
          (looks identical, does not create a scroll container).
       2) Auto-detect fixed/sticky bars of the theme at the top of the viewport (header,
          announcement bar, toolbars) and stick below them. Manual offsets in the section
          settings are used when auto-detect is off. */
    function initSticky(root) {
      if (!root.querySelector('.gsf-ct-header')) return;
      if (window.CSS && CSS.supports('overflow', 'clip')) {
        for (var el = root.parentElement; el && el !== document.body && el !== document.documentElement; el = el.parentElement) {
          var cs = getComputedStyle(el);
          if (/(auto|scroll)/.test(cs.overflowX + cs.overflowY)) break;
          if (cs.overflowX === 'hidden') el.style.overflowX = 'clip';
          if (cs.overflowY === 'hidden') el.style.overflowY = 'clip';
        }
      }
      var auto = root.getAttribute('data-gsf-sticky-auto') === 'true';
      var bars = [], ticking = false;
      function scan() {
        bars = [];
        if (!auto) return;
        var vw = window.innerWidth, vh = window.innerHeight;
        var all = document.body.getElementsByTagName('*');
        for (var i = 0; i < all.length; i++) {
          var node = all[i];
          if (root.contains(node)) continue;
          var pos = getComputedStyle(node).position;
          if (pos !== 'fixed' && pos !== 'sticky') continue;
          var r = node.getBoundingClientRect();
          if (r.width >= vw * 0.5 && r.height > 0 && r.height < vh * 0.4) bars.push(node);
        }
      }
      function update() {
        ticking = false;
        if (!auto) return;
        var offset = 0, vh = window.innerHeight;
        bars.forEach(function (b) {
          var r = b.getBoundingClientRect();
          if (r.top <= 1 && r.bottom > 0 && r.bottom < vh * 0.4 && getComputedStyle(b).visibility !== 'hidden') offset = Math.max(offset, r.bottom);
        });
        root.style.setProperty('--gsf-top', Math.round(offset) + 'px');
      }
      function request() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
      var t;
      function rescan() { clearTimeout(t); t = setTimeout(function () { scan(); request(); }, 150); }
      scan();
      update();
      document.addEventListener('scroll', request, { passive: true, capture: true });
      window.addEventListener('resize', rescan);
      window.addEventListener('load', rescan);
      setTimeout(rescan, 1500);
    }

    /* ---------- Reveal on scroll ---------- */
    function initReveal(root) {
      var items = root.querySelectorAll('[data-gsf-reveal]');
      if (reduceMotion || (window.Shopify && window.Shopify.designMode) || !('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('is-on'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-on'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -60px 0px' });
      items.forEach(function (el) { io.observe(el); });
    }

    function init(root) {
      if (!root || root.dataset.gsfInit) return;
      root.dataset.gsfInit = '1';
      initReveal(root);
      initSticky(root);
      initPricing(root);
      initCompare(root);
    }
    function boot() { document.querySelectorAll('[data-gsf-root]').forEach(init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
    document.addEventListener('shopify:section:load', function (e) { init(e.target.querySelector('[data-gsf-root]')); });
  })();
</script>

{% schema %}
{
  "name": "Globo pricing plans",
  "tag": "div",
  "class": "gsf-section",
  "settings": [
    {
      "type": "header",
      "content": "Feature table sticky header"
    },
    {
      "type": "checkbox",
      "id": "sticky_auto",
      "label": "Auto-detect offset",
      "info": "Places the sticky Basic/Professional bar of the feature table right below any fixed or sticky bar of the theme: header, announcement bar, toolbar. Turn off to use the manual values below.",
      "default": true
    },
    {
      "type": "range",
      "id": "sticky_top",
      "label": "Manual offset – desktop (px)",
      "info": "Height of your theme's sticky header on desktop.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sticky_top_mobile",
      "label": "Manual offset – mobile (px)",
      "info": "Height of your theme's sticky header on screens under 768px.",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Globo pricing plans"
    }
  ]
}
{% endschema %}
