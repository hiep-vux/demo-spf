{%- comment -%}
  Globo – Smart Product Filter & Search: Pricing plans (design: Option A, Polaris colours)

  1. Pricing – Shopify / Shopify Plus switch + product-count slider + 2 plan cards + free-trial bar
  2. Full list of features – collapsible groups with a sticky Basic / Professional header

  All CSS is scoped under .gsf-page, JS is vanilla (no jQuery, no slider library).
  Fonts are served from the theme assets/ folder (gsf-Switzer-*.woff2 / .woff).
  Pricing data: GSF_PRICING in the <script> at the bottom (same tiers and prices as globo.io).
{%- endcomment -%}

{%- assign gsf_pricing_url = 'https://apps.shopify.com/product-filter-and-search#adp-pricing' -%}
{%- assign gsf_trial_url = 'https://apps.shopify.com/product-filter-and-search?utm_source=globosoftware.net&utm_medium=pricing-page&utm_campaign=globosoftware.net&utm_content=try-free-now-button' -%}
{%- assign gsf_top_desktop = section.settings.sticky_top | default: 0 -%}
{%- assign gsf_top_mobile = section.settings.sticky_top_mobile | default: 0 -%}

<style>
  /* ---------- Fonts (Switzer – theme assets) ---------- */
  @font-face { font-family: 'Switzer'; src: url('{{ 'gsf-Switzer-Regular.woff2' | asset_url }}') format('woff2'), url('{{ 'gsf-Switzer-Regular.woff' | asset_url }}') format('woff'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Switzer'; src: url('{{ 'gsf-Switzer-Medium.woff2' | asset_url }}') format('woff2'), url('{{ 'gsf-Switzer-Medium.woff' | asset_url }}') format('woff'); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Switzer'; src: url('{{ 'gsf-Switzer-Semibold.woff2' | asset_url }}') format('woff2'), url('{{ 'gsf-Switzer-Semibold.woff' | asset_url }}') format('woff'); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Switzer'; src: url('{{ 'gsf-Switzer-Bold.woff2' | asset_url }}') format('woff2'), url('{{ 'gsf-Switzer-Bold.woff' | asset_url }}') format('woff'); font-weight: 700; font-style: normal; font-display: swap; }

  /* ---------- Tokens (Polaris light theme) ---------- */
  body.template--page-smart-filter .gpf-demo__storefront.page-wrapper {
    max-width: 100%;
    border-radius: 0;
  }
  body.template--page-smart-filter .gpf-demo__viewport {
    padding-left: 0;
    padding-right: 0;
  }
  .gsf-page {
    --gsf-ink: #303030;
    --gsf-ink-2: #616161;
    --gsf-ink-3: #8A8A8A;
    --gsf-bg: #F1F1F1;
    --gsf-panel: #F7F7F7;
    --gsf-surface: #FFFFFF;
    --gsf-border: #E3E3E3;
    --gsf-border-2: #EBEBEB;
    --gsf-border-strong: #CCCCCC;
    --gsf-fill-brand: #303030;
    --gsf-fill-brand-hover: #1A1A1A;
    --gsf-dark: #1A1A1A;
    --gsf-link: #005BD3;
    --gsf-link-hover: #004299;
    --gsf-focus: #005BD3;
    --gsf-success: #047B5D;
    --gsf-success-on-dark: #92FCAC;
    --gsf-magic: #5700D1;
    --gsf-magic-bg: #E9E5FF;
    --gsf-star: #FFB800;
    --gsf-radius-card: 24px;
    --gsf-top-manual: {{ gsf_top_desktop }}px;
    font-family: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--gsf-ink);
    background: var(--gsf-surface);
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  @media (max-width: 767px) {
    .gsf-page { --gsf-top-manual: {{ gsf_top_mobile }}px; }
  }

  /* ---------- Scoped reset ---------- */
  .gsf-page *, .gsf-page *::before, .gsf-page *::after { box-sizing: border-box; }
  .gsf-page h1, .gsf-page h2, .gsf-page h3, .gsf-page h4, .gsf-page p, .gsf-page figure, .gsf-page blockquote { margin: 0; }
  .gsf-page h1, .gsf-page h2, .gsf-page h3, .gsf-page h4 {
    font-family: inherit;
    color: var(--gsf-ink);
    font-weight: 700;
    letter-spacing: -0.015em;
    text-transform: none;
  }
  .gsf-page ul { list-style: none; margin: 0; padding: 0; }
  .gsf-page img { display: block; max-width: 100%; height: auto; border: 0; }
  .gsf-page a { color: var(--gsf-link); text-decoration: none; transition: color .15s, background-color .15s, border-color .15s; }
  .gsf-page a:hover { color: var(--gsf-link-hover); }
  .gsf-page button {
    font: inherit; color: inherit; background: none; border: 0; margin: 0; padding: 0;
    cursor: pointer; text-align: inherit; letter-spacing: inherit; text-transform: none;
    box-shadow: none; min-height: 0; min-width: 0; border-radius: 0;
  }
  .gsf-page :focus-visible { outline: 2px solid var(--gsf-focus); outline-offset: 2px; }
  .gsf-page [hidden] { display: none !important; }
  .gsf-page svg { flex: 0 0 auto; }

  .gsf-container { width: 100%; max-width: 1248px; margin: 0 auto; padding: 0 28px; }
  @media (max-width: 767px) { .gsf-container { padding: 0 20px; } }

  /* ---------- Typography helpers ---------- */
  .gsf-eyebrow {
    display: block;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gsf-success);
  }
  .gsf-page .gsf-h2 { font-size: 44px; line-height: 1.15; }
  .gsf-lead { font-size: 20px; line-height: 1.55; color: var(--gsf-ink-2); }
  .gsf-section-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
  .gsf-section-head .gsf-h2 { margin-bottom: 12px; }
  @media (max-width: 1024px) { .gsf-page .gsf-h2 { font-size: 36px; } }
  @media (max-width: 767px) {
    .gsf-page .gsf-h2 { font-size: 30px; }
    .gsf-lead { font-size: 17px; }
    .gsf-eyebrow { font-size: 13px; margin-bottom: 8px; }
    .gsf-section-head { text-align: left; margin-bottom: 24px; }
  }

  /* ---------- Buttons ---------- */
  .gsf-page .gsf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1.5px solid transparent;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s;
  }
  .gsf-page .gsf-btn--primary {
    background: var(--gsf-fill-brand);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), inset 0 -2px 0 rgba(0, 0, 0, .55);
  }
  .gsf-page .gsf-btn--primary:hover { background: var(--gsf-fill-brand-hover); color: #fff; }
  .gsf-page .gsf-btn--secondary { background: var(--gsf-surface); color: var(--gsf-ink); border-color: var(--gsf-border-strong); }
  .gsf-page .gsf-btn--secondary:hover { background: var(--gsf-panel); color: var(--gsf-ink); border-color: #B5B5B5; }
  .gsf-page .gsf-btn--light { background: #fff; color: var(--gsf-dark); }
  .gsf-page .gsf-btn--light:hover { background: #E3E3E3; color: var(--gsf-dark); }
  .gsf-page .gsf-btn--sm { height: 40px; padding: 0 18px; font-size: 15px; }
  .gsf-page .gsf-btn--block { display: flex; width: 100%; }

  /* ---------- Reveal on scroll ---------- */
  .gsf-reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
  .gsf-reveal.is-on { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .gsf-reveal { opacity: 1; transform: none; transition: none; }
    .gsf-page * { scroll-behavior: auto !important; }
  }

  /* =========================================================
     1. PRICING
     ========================================================= */
  .gsf-pricing { background: var(--gsf-bg); padding: 96px 0; }
  .gsf-segment { display: inline-flex; padding: 4px; background: var(--gsf-border); border-radius: 999px; margin-top: 28px; }
  .gsf-page .gsf-segment__btn {
    height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    color: var(--gsf-ink-2);
    font-weight: 500;
    transition: background-color .15s, color .15s;
  }
  .gsf-page .gsf-segment__btn[aria-selected="true"] { background: var(--gsf-surface); color: var(--gsf-ink); font-weight: 600; box-shadow: 0 1px 3px rgba(26, 26, 26, .15); }

  .gsf-slider-card {
    background: var(--gsf-surface);
    border: 1px solid var(--gsf-border);
    border-radius: var(--gsf-radius-card);
    padding: 32px 40px 24px;
    margin-bottom: 24px;
  }
  .gsf-slider-card__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; }
  .gsf-slider-card__label { font-size: 18px; font-weight: 600; }
  .gsf-slider-card__value { font-size: 32px; font-weight: 700; line-height: 1; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .gsf-slider-card__value small { font-size: 18px; font-weight: 500; color: var(--gsf-ink-2); }

  /* native range slider */
  .gsf-range-wrap { --thumb: 28px; position: relative; padding-bottom: 32px; }
  .gsf-page .gsf-range {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: var(--thumb);
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    --gsf-fill: 0%;
  }
  .gsf-range:focus { outline: none; }
  .gsf-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--gsf-ink) 0, var(--gsf-ink) var(--gsf-fill), var(--gsf-border) var(--gsf-fill), var(--gsf-border) 100%);
  }
  .gsf-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: var(--thumb);
    height: var(--thumb);
    margin-top: calc((6px - var(--thumb)) / 2);
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--gsf-ink);
    box-shadow: 0 2px 8px rgba(26, 26, 26, .3);
  }
  .gsf-range::-moz-range-track { height: 6px; border-radius: 999px; background: var(--gsf-border); }
  .gsf-range::-moz-range-progress { height: 6px; border-radius: 999px; background: var(--gsf-ink); }
  .gsf-range::-moz-range-thumb {
    width: var(--thumb);
    height: var(--thumb);
    box-sizing: border-box;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--gsf-ink);
    box-shadow: 0 2px 8px rgba(26, 26, 26, .3);
  }
  .gsf-range:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--gsf-focus); outline-offset: 2px; }
  .gsf-range:focus-visible::-moz-range-thumb { outline: 2px solid var(--gsf-focus); outline-offset: 2px; }
  .gsf-range-labels { position: absolute; left: 0; right: 0; bottom: 0; height: 24px; }
  .gsf-page .gsf-range-label {
    position: absolute;
    top: 0;
    left: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--p));
    transform: translateX(-50%);
    font-size: 14px;
    line-height: 24px;
    color: var(--gsf-ink-3);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .gsf-page .gsf-range-label:hover { color: var(--gsf-ink); }
  .gsf-page .gsf-range-label.is-active { color: var(--gsf-ink); font-weight: 600; }
  @media (max-width: 1199px) { .gsf-page .gsf-range-label { font-size: 13px; } }
  .gsf-range-label--first { transform: translateX(calc(-1 * var(--thumb) / 2)) !important; }
  .gsf-range-label--last { transform: translateX(calc(-100% + var(--thumb) / 2)) !important; }

  .gsf-plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .gsf-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px;
    height: 100%;
    background: var(--gsf-surface);
    border: 1px solid var(--gsf-border);
    border-radius: var(--gsf-radius-card);
  }
  .gsf-plan--pro { border: 2px solid var(--gsf-ink); box-shadow: 0 24px 48px -24px rgba(26, 26, 26, .35); }
  .gsf-plan__badge {
    position: absolute;
    top: -14px;
    left: 32px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--gsf-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .gsf-plan__name { font-size: 22px; font-weight: 700; line-height: 1.3; }
  .gsf-plan__desc { color: var(--gsf-ink-2); }
  .gsf-plan__price { display: flex; align-items: baseline; gap: 6px; }
  .gsf-plan__amount { font-size: 52px; font-weight: 700; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .gsf-plan__per { color: var(--gsf-ink-2); }
  .gsf-plan__yearly { margin-top: 8px; font-size: 15px; color: var(--gsf-ink-2); font-variant-numeric: tabular-nums; }
  .gsf-save { color: var(--gsf-success); font-weight: 600; }
  .gsf-plan__divider { height: 1px; background: var(--gsf-border); }
  .gsf-plan__plus { font-size: 14px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gsf-ink-2); }
  .gsf-checklist { display: flex; flex-direction: column; gap: 12px; }
  .gsf-checklist li { display: flex; gap: 12px; align-items: flex-start; }
  .gsf-checklist svg { margin-top: 3px; color: var(--gsf-success); }
  .gsf-page .gsf-plan__more-btn { display: none; }

  .gsf-trial-bar {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 32px;
    border-radius: 20px;
    background: var(--gsf-ink);
    color: #fff;
  }
  .gsf-trial-bar__text { font-size: 20px; font-weight: 600; }
  @media (max-width: 1024px) {
    .gsf-slider-card { padding: 24px 24px 20px; }
    .gsf-plan { padding: 28px 24px; }
    .gsf-range-label--d { display: none; }
  }
  @media (max-width: 767px) {
    .gsf-pricing { padding: 48px 0; }
    .gsf-segment { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; margin-top: 20px; }
    .gsf-slider-card { padding: 20px 20px 16px; border-radius: 20px; margin-bottom: 16px; }
    .gsf-slider-card__head { flex-direction: column; align-items: flex-start; gap: 4px; margin-bottom: 14px; }
    .gsf-slider-card__label { font-size: 15px; color: var(--gsf-ink-2); }
    .gsf-slider-card__value { font-size: 30px; }
    .gsf-slider-card__value small { font-size: 16px; }
    .gsf-range-wrap { --thumb: 32px; }
    .gsf-page .gsf-range { height: 44px; }
    .gsf-range-label--t { display: none; }
    .gsf-plans { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .gsf-plan { padding: 24px 20px 20px; border-radius: 20px; gap: 16px; }
    .gsf-plan--pro { order: -1; }
    .gsf-plan__badge { left: 20px; top: -13px; font-size: 12px; }
    .gsf-plan__name { font-size: 20px; }
    .gsf-plan__amount { font-size: 42px; }
    .gsf-checklist { gap: 10px; font-size: 15px; }
    .gsf-plan__divider { display: none; }
    .gsf-plan:not(.is-expanded) .gsf-checklist__more { display: none; }
    .gsf-page .gsf-plan__more-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      height: 44px;
      margin-top: -6px;
      font-size: 15px;
      font-weight: 600;
      color: var(--gsf-link);
    }
    .gsf-plan.is-expanded .gsf-plan__more-btn svg { transform: rotate(180deg); }
    .gsf-trial-bar { flex-direction: column; align-items: stretch; text-align: center; gap: 14px; padding: 22px 20px; margin-top: 16px; }
    .gsf-trial-bar__text { font-size: 18px; }
    .gsf-trial-bar .gsf-btn { width: 100%; }
  }

  /* =========================================================
     2. FULL LIST OF FEATURES
     ========================================================= */
  .gsf-compare { padding: 96px 0 35px 0; }
  .gsf-compare__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 28px; }
  .gsf-compare__table { position: relative; }
  .gsf-ct-row { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); }
  .gsf-ct-header {
    position: sticky;
    top: var(--gsf-top, var(--gsf-top-manual));
    z-index: 15;
    background: var(--gsf-surface);
    border: 1px solid var(--gsf-border);
    border-radius: 16px 16px 0 0;
    box-shadow: 0 8px 24px -16px rgba(26, 26, 26, .25);
    transition: top .2s ease;
  }
  .gsf-ct-header__caption { padding: 20px 24px; display: flex; align-items: center; color: var(--gsf-ink-2); font-size: 15px; }
  .gsf-ct-header__plan { padding: 16px; border-left: 1px solid var(--gsf-border); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .gsf-ct-header__plan--pro { background: var(--gsf-panel); }
  .gsf-ct-header__name { font-size: 18px; font-weight: 700; }
  .gsf-page .gsf-ct-header__btn {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--gsf-border-strong);
    color: var(--gsf-ink);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .gsf-page .gsf-ct-header__btn:hover { background: var(--gsf-panel); color: var(--gsf-ink); }
  .gsf-page .gsf-ct-header__btn--primary { background: var(--gsf-ink); border-color: var(--gsf-ink); color: #fff; }
  .gsf-page .gsf-ct-header__btn--primary:hover { background: var(--gsf-fill-brand-hover); color: #fff; }
  .gsf-ct-body { border: 1px solid var(--gsf-border); border-top: 0; border-radius: 0 0 16px 16px; overflow: hidden; }
  .gsf-page .gsf-ct-group__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
    padding: 16px 24px;
    background: var(--gsf-surface);
    border-bottom: 1px solid var(--gsf-border);
    text-align: left;
    transition: background-color .15s;
  }
  .gsf-page .gsf-ct-group__toggle:hover { background: var(--gsf-panel); }
  .gsf-page .gsf-ct-group__toggle[aria-expanded="true"] { background: var(--gsf-bg); }
  .gsf-ct-group__title { font-size: 18px; font-weight: 700; }
  .gsf-ct-group__count { font-size: 15px; font-weight: 500; color: var(--gsf-ink-2); }
  .gsf-ct-group__toggle svg { transition: transform .2s ease; }
  .gsf-ct-group__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .gsf-ct-group__panel { overflow: hidden; transition: height .3s ease; }
  .gsf-ct-row--item { border-bottom: 1px solid var(--gsf-border-2); }
  .gsf-ct-cell { min-width: 0; padding: 14px 24px; display: flex; align-items: center; gap: 8px; }
  .gsf-ct-cell--val { justify-content: center; padding: 14px; border-left: 1px solid var(--gsf-border-2); font-weight: 600; font-variant-numeric: tabular-nums; }
  .gsf-ct-cell--pro { background: #FAFAFA; }
  .gsf-ct-check { display: block; width: 20px; height: 20px; position: relative; }
  .gsf-ct-check::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 2px;
    width: 6px;
    height: 12px;
    border: solid var(--gsf-success);
    border-width: 0 2.4px 2.4px 0;
    transform: rotate(45deg);
  }
  .gsf-ct-dash { color: #B5B5B5; }
  .gsf-ai-badge { padding: 2px 8px; border-radius: 999px; background: var(--gsf-magic-bg); color: var(--gsf-magic); font-size: 12px; font-weight: 600; line-height: 1.4; }
  .gsf-visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 767px) {
    .gsf-compare { padding: 48px 0; }
    .gsf-compare__head { align-items: center; margin-bottom: 16px; }
    .gsf-page .gsf-compare__head .gsf-h2 { font-size: 26px; }
    .gsf-compare__head .gsf-btn { height: 36px; padding: 0 12px; font-size: 13px; }
    .gsf-ct-row { grid-template-columns: minmax(0, 1fr) 76px 92px; }
    .gsf-ct-header { border-radius: 14px 14px 0 0; box-shadow: 0 8px 20px -14px rgba(26, 26, 26, .3); }
    .gsf-ct-header__caption { padding: 12px; font-size: 13px; }
    .gsf-ct-header__plan { padding: 12px 4px; }
    .gsf-ct-header__name { font-size: 14px; }
    .gsf-ct-header__btn { display: none !important; }
    .gsf-ct-body { border-radius: 0 0 14px 14px; }
    .gsf-page .gsf-ct-group__toggle { min-height: 52px; padding: 14px 12px; }
    .gsf-ct-group__title { font-size: 16px; }
    .gsf-ct-group__count { font-size: 14px; }
    .gsf-ct-cell { padding: 12px; font-size: 14px; line-height: 1.4; }
    .gsf-ct-cell--val { padding: 12px 4px; }
    .gsf-ai-badge { font-size: 11px; padding: 1px 6px; }
  }

</style>

{%- comment -%} Shared inline icons {%- endcomment -%}
